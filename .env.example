# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 키. 서버 전용(NEXT_PUBLIC_ 접두사 금지)
GEMINI_API_KEY=

# 선택: 사용할 모델 (기본값 gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# 선택: AI 호출 1회당 타임아웃(ms, 기본값 20000)
# AI_TIMEOUT_MS=20000

# Supabase (Project Settings → API). URL과 공개(anon/publishable) 키는 브라우저에 노출돼도 된다(RLS가 보호).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이거나 커밋하지 않는다.
# 의견 저장·rate limit에만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# 선택: IP 해시용 솔트(임의의 긴 문자열). 없으면 서비스 롤 키에서 파생한다.
# RATE_LIMIT_SALT=
